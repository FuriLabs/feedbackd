From 4e1045e5525a415491af23be05428445f04b05b6 Mon Sep 17 00:00:00 2001
From: Arnaud Ferraris <arnaud.ferraris@collabora.com>
Date: Wed, 15 Apr 2020 11:55:03 +0200
Subject: [PATCH] cli: add and install manpage

---
 cli/fbcli.1     | 42 ++++++++++++++++++++++++++++++++++++++++++
 cli/meson.build |  2 ++
 2 files changed, 44 insertions(+)
 create mode 100644 cli/fbcli.1

diff --git a/cli/fbcli.1 b/cli/fbcli.1
new file mode 100644
index 0000000..193090d
--- /dev/null
+++ b/cli/fbcli.1
@@ -0,0 +1,42 @@
+.TH "FBCLI" "1" "04/14/2020" "fbcli 0\&.0\&.0\+git20200305" "feedbackd"
+.SH "NAME"
+fbcli \- Command\-line utility aimed at testing feedbackd
+.SH "SYNOPSIS"
+.HP \w'\fBfbcli\fR\ 'u
+\fBfbcli\fR [OPTION...]
+.SH "DESCRIPTION"
+.PP
+fbcli is a simple command\-line utility for feedbackd testing\&. It can be
+used to trigger specific events and check the appropriate feedback actions
+(play sound, vibrate...) are executed\&.
+.SH "OPTIONS"
+.SS "Help Options"
+.PP
+\fB\-h\fR, \fB\-\-help\fR
+.RS 4
+Show help
+.RE
+.SS "Application Options"
+.PP
+\fB\-E\fR, \fB\-\-event\fR
+.RS 4
+Event name (default: phone\-incoming\-call)\&.
+.RE
+.PP
+\fB\-t\fR, \fB\-\-timeout\fR
+.RS 4
+Run feedback for timeout seconds\&.
+.RE
+.PP
+\fB\-P\fR, \fB\-\-profile\fR
+.RS 4
+Profile name to set\&.
+.RE
+.PP
+\fB\-w\fR, \fB\-\-watch\fR
+.RS 4
+How long to watch for feedback longest\&.
+.RE
+.SH "AUTHORS"
+.PP
+\fBArnaud Ferraris\fR <\&arnaud\&.ferraris@collabora\&.com\&>
diff --git a/cli/meson.build b/cli/meson.build
index e542e1c..1b0c25e 100644
--- a/cli/meson.build
+++ b/cli/meson.build
@@ -14,3 +14,5 @@ executable(
   dependencies: fbcli_deps,
   install: true,
 )
+
+install_man('fbcli.1')
-- 
2.25.1
